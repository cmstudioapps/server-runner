{
  "name": "server-runner",
  "version": "2.0.0",
  "description": "Painel desktop para gerenciar servidores locais",
  "main": "main.js",
  "author": {
    "name": "ServerRunner",
    "email": "dev@serverrunner.app"
  },
  "scripts": {
    "start": "electron .",
    "dev": "ELECTRON_DEV=true electron .",
    "build:linux": "electron-builder --linux deb",
    "build:win": "electron-builder --win portable",
    "build:win-installer": "electron-builder --win nsis",
    "build:dir": "electron-builder --linux dir",
    "dist": "electron-builder --linux deb",
    "dist:all": "electron-builder --linux deb --win portable",
    "build:all": "npm run build:linux && npm run build:win"
  },
  "homepage": "https://github.com/serverrunner/app",
  "keywords": [
    "server",
    "manager",
    "dashboard",
    "electron"
  ],
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "localtunnel": "^2.0.2",
    "node-pty": "^1.0.0",
    "systeminformation": "^5.21.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "@electron/rebuild": "^3.6.0"
  },
  "build": {
    "appId": "com.serverrunner.app",
    "productName": "ServerRunner",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "modules/**/*",
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["deb"],
      "category": "Development",
      "icon": "build/icons"
    },
    "deb": {
      "depends": []
    },
    "win": {
      "target": ["portable"],
      "icon": "build/icons"
    },
    "portable": {
      "artifactName": "ServerRunner-${version}-portable.${ext}"
    }
  }
}
